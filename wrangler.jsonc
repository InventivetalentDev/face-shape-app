{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whattheface",
  "compatibility_date": "2026-11-13",
  // Static-only: no Worker script, Cloudflare serves the Vite build output directly.
  "assets": {
    "directory": "./dist"
  },
  "routes": [
    { "pattern": "whattheface.app", "custom_domain": true }
  ]
}
